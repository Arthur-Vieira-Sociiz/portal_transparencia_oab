generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GeneralDataStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                        String              @id @default(cuid())
  name                      String
  email                     String              @unique
  passwordHash              String
  role                      UserRole            @default(EDITOR)
  status                    UserStatus          @default(ACTIVE)
  lastLoginAt               DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  sessions                  Session[]
  createdGeneralData        GeneralData[]       @relation("GeneralDataCreatedBy")
  updatedGeneralData        GeneralData[]       @relation("GeneralDataUpdatedBy")
  createdBudgetRecords      BudgetRecord[]      @relation("BudgetCreatedBy")
  updatedBudgetRecords      BudgetRecord[]      @relation("BudgetUpdatedBy")
  createdFinancialDocuments FinancialDocument[] @relation("FinancialCreatedBy")
  updatedFinancialDocuments FinancialDocument[] @relation("FinancialUpdatedBy")
  createdPatrimonialAssets  PatrimonialAsset[]  @relation("PatrimonialCreatedBy")
  updatedPatrimonialAssets  PatrimonialAsset[]  @relation("PatrimonialUpdatedBy")
  createdContracts          ContractRecord[]    @relation("ContractCreatedBy")
  updatedContracts          ContractRecord[]    @relation("ContractUpdatedBy")
  createdHumanResources     HumanResourcesRecord[] @relation("HumanResourcesCreatedBy")
  updatedHumanResources     HumanResourcesRecord[] @relation("HumanResourcesUpdatedBy")
  createdReportsIndicators  ReportsIndicator[] @relation("ReportsIndicatorCreatedBy")
  updatedReportsIndicators  ReportsIndicator[] @relation("ReportsIndicatorUpdatedBy")
}

model GeneralData {
  id                String            @id @default(cuid())
  exercise          Int
  totalExpenses     Decimal           @db.Decimal(14, 2)
  totalRevenue      Decimal           @db.Decimal(14, 2)
  budget            Decimal           @db.Decimal(14, 2)
  patrimony         Decimal           @db.Decimal(14, 2)
  activeLawyers     Int
  activeSocieties   Int
  supportRooms      Int
  registeredMembers Int
  status            GeneralDataStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String
  updatedById       String
  createdBy         User              @relation("GeneralDataCreatedBy", fields: [createdById], references: [id])
  updatedBy         User              @relation("GeneralDataUpdatedBy", fields: [updatedById], references: [id])

  @@unique([exercise])
  @@index([status, exercise])
  @@index([createdById])
  @@index([updatedById])
}

model BudgetRecord {
  id              String            @id @default(cuid())
  informationType String
  annualBudget    Decimal           @db.Decimal(14, 2)
  plannedAmount   Decimal           @db.Decimal(14, 2)
  executedAmount  Decimal           @db.Decimal(14, 2)
  exercise        Int
  documentTitle   String?
  documentUrl     String?
  status          GeneralDataStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String
  updatedById     String
  createdBy       User              @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  updatedBy       User              @relation("BudgetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([informationType, exercise])
  @@index([status, exercise])
}

model FinancialDocument {
  id              String            @id @default(cuid())
  informationType String
  period          String
  exercise        Int
  documentTitle   String
  documentUrl     String?
  pdfUrl          String?
  csvUrl          String?
  status          GeneralDataStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String
  updatedById     String
  createdBy       User              @relation("FinancialCreatedBy", fields: [createdById], references: [id])
  updatedBy       User              @relation("FinancialUpdatedBy", fields: [updatedById], references: [id])

  @@unique([informationType, period, exercise])
  @@index([status, exercise])
}

model HumanResourcesRecord {
  id          String            @id @default(cuid())
  exercise    Int
  locality    String
  months      Json
  status      GeneralDataStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String
  updatedById String
  createdBy   User              @relation("HumanResourcesCreatedBy", fields: [createdById], references: [id])
  updatedBy   User              @relation("HumanResourcesUpdatedBy", fields: [updatedById], references: [id])

  @@unique([exercise, locality])
  @@index([status, exercise])
}

model ReportsIndicator {
  id                   String            @id @default(cuid())
  exercise             Int               @unique
  totalRevenue         Decimal           @db.Decimal(14, 2)
  totalExpense         Decimal           @db.Decimal(14, 2)
  exerciseResult       Decimal           @db.Decimal(14, 2)
  plannedBudget        Decimal           @db.Decimal(14, 2)
  executedBudget       Decimal           @db.Decimal(14, 2)
  executionPercentage  Decimal           @db.Decimal(5, 2)
  activeLawyers        Int
  interns              Int
  registeredSocieties  Int
  appointments         Int
  protocols            Int
  certificates         Int
  ombudsmanRequests    Int
  activeContracts      Int
  totalContractValue   Decimal           @db.Decimal(14, 2)
  newBids              Int
  closedContracts      Int
  employees            Int
  status               GeneralDataStatus @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  createdById          String
  updatedById          String
  createdBy            User              @relation("ReportsIndicatorCreatedBy", fields: [createdById], references: [id])
  updatedBy            User              @relation("ReportsIndicatorUpdatedBy", fields: [updatedById], references: [id])

  @@index([status, exercise])
}

model PatrimonialAsset {
  id               String            @id @default(cuid())
  informationType  String
  description      String
  location         String
  acquisitionValue Decimal           @db.Decimal(14, 2)
  status           String
  exercise         Int
  documentTitle    String?
  documentUrl      String?
  statusState      GeneralDataStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String
  updatedById      String
  createdBy        User              @relation("PatrimonialCreatedBy", fields: [createdById], references: [id])
  updatedBy        User              @relation("PatrimonialUpdatedBy", fields: [updatedById], references: [id])

  @@unique([informationType, description, exercise])
  @@index([statusState, exercise])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  cnpj      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContractRecord {
  id                  String            @id @default(cuid())
  supplierName        String
  cnpj                String
  objectDescription   String?
  signedAt            String
  term                String
  value               Decimal           @db.Decimal(14, 2)
  exercise            Int
  contractDocumentUrl String?
  amendmentUrls       Json
  statusState         GeneralDataStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdById         String
  updatedById         String
  createdBy           User              @relation("ContractCreatedBy", fields: [createdById], references: [id])
  updatedBy           User              @relation("ContractUpdatedBy", fields: [updatedById], references: [id])

  @@unique([supplierName, signedAt, exercise])
  @@index([statusState, exercise])
}
