generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  REVIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GeneralDataStatus {
  DRAFT
  PUBLISHED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(EDITOR)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions            Session[]
  createdGeneralData  GeneralData[] @relation("GeneralDataCreatedBy")
  updatedGeneralData  GeneralData[] @relation("GeneralDataUpdatedBy")
  createdBudgetRecords BudgetRecord[] @relation("BudgetCreatedBy")
  updatedBudgetRecords BudgetRecord[] @relation("BudgetUpdatedBy")
}

model GeneralData {
  id                String            @id @default(cuid())
  exercise          Int
  totalExpenses     Decimal           @db.Decimal(14, 2)
  totalRevenue      Decimal           @db.Decimal(14, 2)
  budget            Decimal           @db.Decimal(14, 2)
  patrimony         Decimal           @db.Decimal(14, 2)
  activeLawyers     Int
  activeSocieties   Int
  supportRooms      Int
  registeredMembers Int
  status            GeneralDataStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       String
  updatedById       String
  createdBy         User              @relation("GeneralDataCreatedBy", fields: [createdById], references: [id])
  updatedBy         User              @relation("GeneralDataUpdatedBy", fields: [updatedById], references: [id])

  @@unique([exercise])
  @@index([status, exercise])
  @@index([createdById])
  @@index([updatedById])
}

model BudgetRecord {
  id                  String            @id @default(cuid())
  informationType     String
  annualBudget        Decimal           @db.Decimal(14, 2)
  plannedAmount       Decimal           @db.Decimal(14, 2)
  executedAmount      Decimal           @db.Decimal(14, 2)
  exercise            Int
  documentTitle       String?
  documentUrl         String?
  status              GeneralDataStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdById         String
  updatedById         String
  createdBy           User              @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  updatedBy           User              @relation("BudgetUpdatedBy", fields: [updatedById], references: [id])

  @@unique([informationType, exercise])
  @@index([status, exercise])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
