# API
PORT=3333
# Aceita uma ou mais origens separadas por vírgula quando os previews forem configurados.
WEB_ORIGIN=http://localhost:5173

# Banco: use a URL direta somente nas migrations e a pool na API/Vercel.
# Nunca envie os valores reais para o Git.
# Essas variáveis serão removidas ao final da migração para o Firestore.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL_POOLED=postgresql://usuario:senha@host-pooler/banco?sslmode=require

# Firebase Admin SDK: use a conta de serviço do projeto da empresa.
# Mantenha as quebras de linha da chave privada escapadas como \n.
FIREBASE_PROJECT_ID=transparencia-oab-al
FIREBASE_CLIENT_EMAIL=conta-de-servico@transparencia-oab-al.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Chave exclusiva para criar usuários administrativos. Gere uma senha longa
# e aleatória; ela não é a senha de login de nenhum usuário.
ADMIN_REGISTRATION_KEY=troque-por-uma-chave-longa-e-aleatoria
SESSION_TTL_HOURS=8
