# API
PORT=3333
# Aceita uma ou mais origens separadas por vírgula quando os previews forem configurados.
WEB_ORIGIN=http://localhost:5173

# Banco: use a URL direta somente nas migrations e a pool na API/Vercel.
# Nunca envie os valores reais para o Git.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL_POOLED=postgresql://usuario:senha@host-pooler/banco?sslmode=require

# Chave exclusiva para criar usuários administrativos. Gere uma senha longa
# e aleatória; ela não é a senha de login de nenhum usuário.
ADMIN_REGISTRATION_KEY=troque-por-uma-chave-longa-e-aleatoria
SESSION_TTL_HOURS=8
